{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.mawjood.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.rezeqaysar.mawjood",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "22"
    },
    "name": "Mawjood",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": false,
          "microphonePermission": "Allow Mawjood to record your voice notes."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mawjood to access your photos to attach them to notes.",
          "cameraPermission": "Allow Mawjood to take photos to attach them to notes."
        }
      ]
    ],
    "scheme": "mawjood",
    "slug": "mawjood",
    "userInterfaceStyle": "light",
    "version": "0.1.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Mawjood — موجود",
      "shortName": "Mawjood",
      "description": "Bilingual voice-memory assistant: say where things are, ask where they went.",
      "lang": "en",
      "themeColor": "#FAF7F2",
      "backgroundColor": "#FAF7F2",
      "display": "standalone",
      "orientation": "portrait"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e464152-4348-424b-8632-9ebb5028837e"
      }
    },
    "owner": "rezeqaysar"
  }
}
